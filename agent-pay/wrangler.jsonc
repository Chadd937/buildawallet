{
  "name": "buildawallet-agent-pay",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-23",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "buildawallet.xyz/machine/*", "zone_name": "buildawallet.xyz" },
    { "pattern": "buildawallet.xyz/human", "zone_name": "buildawallet.xyz" },
    { "pattern": "buildawallet.xyz/human/*", "zone_name": "buildawallet.xyz" },
    { "pattern": "buildawallet.xyz/app.js", "zone_name": "buildawallet.xyz" },
    { "pattern": "buildawallet.xyz/pay", "zone_name": "buildawallet.xyz" }
    ,{ "pattern": "buildawallet.xyz/mcp", "zone_name": "buildawallet.xyz" }
    ,{ "pattern": "buildawallet.xyz/.well-known/agent.json", "zone_name": "buildawallet.xyz" }
    ,{ "pattern": "buildawallet.xyz/llms.txt", "zone_name": "buildawallet.xyz" }
    ,{ "pattern": "buildawallet.xyz/agent-offer.json", "zone_name": "buildawallet.xyz" }
    ,{ "pattern": "buildawallet.xyz/openapi.json", "zone_name": "buildawallet.xyz" }
    ,{ "pattern": "buildawallet.xyz/api-docs", "zone_name": "buildawallet.xyz" }
    ,{ "pattern": "buildawallet.xyz/api-docs/*", "zone_name": "buildawallet.xyz" }
    ,{ "pattern": "buildawallet.xyz/docs/api", "zone_name": "buildawallet.xyz" }
    ,{ "pattern": "buildawallet.xyz/docs", "zone_name": "buildawallet.xyz" }
    ,{ "pattern": "buildawallet.xyz/pricing", "zone_name": "buildawallet.xyz" }
    ,{ "pattern": "buildawallet.xyz/terms", "zone_name": "buildawallet.xyz" }
    ,{ "pattern": "buildawallet.xyz/privacy", "zone_name": "buildawallet.xyz" }
  ],
  "services": [
    { "binding": "HUMAN_API", "service": "buildawallet-human-api" }
  ],
  "d1_databases": [
    { "binding": "DB", "database_name": "buildawallet", "database_id": "00000000-0000-4000-8000-000000000001", "migrations_dir": "../cloudflare-human/migrations" }
  ],
  "ratelimits": [
    { "name": "REQUEST_RATE_LIMITER", "namespace_id": "8127543", "simple": { "limit": 60, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
