# Copy to human-app/.env. Keep the filled copy private and out of Git.
# The existing Login Worker owns email delivery, accounts and HttpOnly sessions.
# Use its existing D1 database name and cookie name; do not rotate its secrets.
# AUTH_DATABASE_NAME=the_existing_login_database
# Only set this if the Login Worker customizes its cookie name.
# Extracted auth_* defaults to site_session; original human_* uses baw_human_session.
# AUTH_COOKIE_NAME=your_existing_login_cookie
# Existing app/legacy D1 is reused by default; new application tables are additive.
APP_DATABASE_NAME=buildawallet
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional HTTPS Responses API-compatible endpoint.
OPENAI_BASE_URL=
BASE_RPC_URL=
SOLANA_RPC_URL=
