# Server secrets belong in local .env (ignored) and Cloudflare secrets.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Must match AUTH_SESSION_SIGNING_KEY on the cloudflare-email-auth Worker.
AUTH_SESSION_SIGNING_KEY=
AUTH_JWT_ISSUER=buildawallet-auth
AUTH_JWT_AUDIENCE=buildawallet-app
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional: an HTTPS OpenAI-compatible Responses API endpoint.
OPENAI_BASE_URL=
BASE_RPC_URL=
SOLANA_RPC_URL=
# PostgreSQL connection URL for applying app SQL migrations.
DATABASE_URL=
