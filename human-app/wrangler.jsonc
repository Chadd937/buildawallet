{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "buildawallet-agent-pay",
  "main": "src/server.ts",
  "compatibility_date": "2026-10-04",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "buildawallet.xyz/*",
      "zone_name": "buildawallet.xyz"
    },
    {
      "pattern": "buildawallet.xyz/api/public/*",
      "zone_name": "buildawallet.xyz"
    },
    {
      "pattern": "buildawallet.xyz/api/human-ai",
      "zone_name": "buildawallet.xyz"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": false
    }
  },
  "vars": {
    "SUPABASE_URL": "https://vfvidjzggojmptbxnqep.supabase.co",
    "AUTH_JWT_ISSUER": "buildawallet-auth",
    "AUTH_JWT_AUDIENCE": "buildawallet-app"
  }
}
