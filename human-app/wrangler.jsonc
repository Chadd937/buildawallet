{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "buildawallet-agent-pay",
  "main": "src/server.ts",
  "compatibility_date": "2026-10-04",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "buildawallet.xyz/*",
      "zone_name": "buildawallet.xyz"
    },
    {
      "pattern": "buildawallet.xyz/api/public/*",
      "zone_name": "buildawallet.xyz"
    },
    {
      "pattern": "buildawallet.xyz/api/human-ai",
      "zone_name": "buildawallet.xyz"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": false
    }
  },
  "vars": {
    "AUTH_COOKIE_NAME": "baw_human_session",
    "AUTH_TABLE_PREFIX": "human",
    "AI_PROVIDER": "workers-ai",
    "AI_MODEL": "@cf/meta/llama-3.1-8b-instruct-fast"
  },
  "ai": { "binding": "AI" },
  "ratelimits": [
    { "name": "REQUEST_RATE_LIMITER", "namespace_id": "8127543", "simple": { "limit": 60, "period": 60 } }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "buildawallet",
      "database_id": "f9bc91c2-f66f-4fbe-a099-8913952584e3",
      "migrations_dir": "migrations",
      "migrations_table": "baw_app_migrations"
    },
    {
      "binding": "AUTH_DB",
      "database_name": "buildawallet",
      "database_id": "f9bc91c2-f66f-4fbe-a099-8913952584e3"
    }
  ]
}
